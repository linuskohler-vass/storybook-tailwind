<swg-embedded-media>
    <div class="swiper-slide">
        <div class="swg-embedded-media-item">
            <picture>
                <source media="(min-width: 768px)" data-srcset="https://dummyimage.com/1200x675">
                <source media="(min-width: 0px)" data-srcset="https://dummyimage.com/600x338">
                <img src="https://dummyimage.com/600x338?text=Image+1" alt="Placeholder Image 1">
            </picture>
        </div>
    </div>

    <!-- Slide 2 -->
    <div class="swiper-slide">
        <div class="swg-embedded-media-item">
            <picture>
                <source media="(min-width: 768px)" data-srcset="https://dummyimage.com/1200x675">
                <source media="(min-width: 0px)" data-srcset="https://dummyimage.com/600x338">
                <img src="https://dummyimage.com/600x338?text=Image+2" alt="Placeholder Image 2">
            </picture>
        </div>
    </div>

    <!-- Slide 3 - Video -->
    <div class="swiper-slide">
        <div class="swg-embedded-media-item-video">
            <div class="swg-embedded-media-item-video__button-play"></div>
            <div class="swg-embedded-media-item-video__container">
                <iframe class="swg-embedded-media-item-video__container-video-iframe"
                        src="https://www.youtube.com/embed/dQw4w9WgXcQ?enablejsapi=1&rel=0"
                        frameborder="0"
                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen>
                </iframe>
            </div>
            <picture>
                <source media="(min-width: 768px)" data-srcset="https://dummyimage.com/1200x675">
                <source media="(min-width: 0px)" data-srcset="https://dummyimage.com/600x338">
                <img src="https://dummyimage.com/600x338?text=Video+Thumbnail" alt="Video Thumbnail">
            </picture>
        </div>
    </div>
</swg-embedded-media>

<!-- Embedded Media with Thumbnails -->
<h2>Slider with Thumbnails</h2>
<swg-embedded-media data-slider-id="#thumbnail-slider">
    <div class="swiper-slide" style="height: 338px;">
        <div class="swg-embedded-media-item">
            <picture>
                <source media="(min-width: 768px)" data-srcset="https://dummyimage.com/1200x675">
                <source media="(min-width: 0px)" data-srcset="https://dummyimage.com/600x338">
                <img src="https://dummyimage.com/600x338?text=Image+1" alt="Placeholder Image 1">
            </picture>
        </div>
    </div>

    <!-- Slide 2 -->
    <div class="swiper-slide">
        <div class="swg-embedded-media-item" style="height: 338px;">
            <picture>
                <source media="(min-width: 768px)" data-srcset="https://dummyimage.com/1200x675">
                <source media="(min-width: 0px)" data-srcset="https://dummyimage.com/600x338">
                <img src="https://dummyimage.com/600x338?text=Image+2" alt="Placeholder Image 2">
            </picture>
        </div>
    </div>

    <!-- Slide 3 - Video -->
    <div class="swiper-slide">
        <div class="swg-embedded-media-item-video" style="height: 338px;">
            <div class="swg-embedded-media-item-video__button-play"></div>
            <div class="swg-embedded-media-item-video__container">
                <iframe class="swg-embedded-media-item-video__container-video-iframe"
                        src="https://www.youtube.com/embed/dQw4w9WgXcQ?enablejsapi=1&rel=0"
                        frameborder="0"
                        allow="accelerometer; autoplay; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen>
                </iframe>
            </div>
            <picture>
                <source media="(min-width: 768px)" data-srcset="https://dummyimage.com/1200x675">
                <source media="(min-width: 0px)" data-srcset="https://dummyimage.com/600x338">
                <img src="https://dummyimage.com/600x338?text=Video+Thumbnail" alt="Video Thumbnail">
            </picture>
        </div>
    </div>
</swg-embedded-media>
