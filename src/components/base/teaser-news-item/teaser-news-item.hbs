<h2>News</h2>
<div data-init="teaser-news-item" class="teaser-news-item">
    <div class="images">
        {{#each items}}
            <img src="{{image}}" class="opacity-0" />
        {{/each}}
    </div>
    <ul class="teaser-news-items group/newsItems">
        {{#each items}}
            <li class="teaser-news-items--item group/item">
                <a href="{{url}}">
                    <img src="{{image}}" />
                    <div>
                        {{#if titleColor}}
                            <h3 class="{{titleColor}} lg:group-hover/item:text-red-500">{{title}}</h3>
                        {{else}}
                            <h3 class="">{{title}}</h3>
                        {{/if}}

                        <div class="meta">
                            <span class="after:content-['_|'] lg:text-gray-500">{{date}}</span>
                            <span>{{category}}</span>
                        </div>
                        <div class="text">
                            {{text}}
                        </div>
                    </div>
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="15" viewBox="0 0 16 15">
                        <polygon fill-rule="evenodd" points="365 105 363.6 106.313 369.2 111.563 357 111.563 357 113.438 369.2 113.438 363.6 118.688 365 120 373 112.5" transform="translate(-357 -105)"></polygon>
                    </svg>
                </a>
            </li>
        {{/each}}
        <span class="background-animation"></span>
    </ul>
</div>
