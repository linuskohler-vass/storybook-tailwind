{
  "name": "storybook-tailwind",
  "version": "1.1.0",
  "description": "Demo setup with Storybook and Tailwind",
  "main": "index.html",
  "scripts": {
    "start": "npm run precompile:hbs && run-p watch:hbs storybook",
    "watch:hbs": "chokidar 'src/**/*.hbs' -c 'npm run precompile:hbs'",
    "precompile:hbs": "node scripts/compile-hbs.js",
    "build": "vite build",
    "storybook": "storybook dev -p 6006 --no-open",
    "test": "echo \"Error: no test specified\" && exit 1",
    "lint:js": "eslint './src/**/*.{js,jsx}'",
    "lint:css": "stylelint './src/**/*.css'",
    "format": "prettier --write './src/**/*.{css,jsx}'",
    "lint": "npm run format && npm run lint:js && npm run lint:css"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linuskohler-vass/storybook-tailwind.git"
  },
  "keywords": [],
  "author": "Linus Kohler",
  "bugs": {
    "url": "https://github.com/linuskohler-vass/storybook-tailwind/issues"
  },
  "homepage": "https://github.com/linuskohler-vass/storybook-tailwind#readme",
  "devDependencies": {
    "@babel/core": "^7.28.6",
    "@babel/preset-env": "^7.28.6",
    "@chromatic-com/storybook": "^5.0.0",
    "@eslint/js": "^9.38.0",
    "@storybook/addon-docs": "^10.2.0",
    "@storybook/html-vite": "^10.2.0",
    "@tailwindcss/postcss": "^4.1.13",
    "babel-preset-solid": "^1.9.9",
    "chokidar-cli": "^3.0.0",
    "eslint": "^9.32.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-storybook": "^10.2.0",
    "fs-extra": "^11.3.2",
    "glob": "^13.0.0",
    "globals": "^17.1.0",
    "handlebars": "^4.7.8",
    "handlebars-layouts": "^3.1.4",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.3",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.1",
    "solid-js": "^1.9.9",
    "storybook": "^10.2.0",
    "stylelint": "^17.0.0",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.1.15",
    "vite": "^7.1.12",
    "vite-plugin-handlebars": "^2.0.0",
    "vite-plugin-solid": "^2.11.10"
  }
}
